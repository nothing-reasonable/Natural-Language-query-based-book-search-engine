# Copy to .env. Paths are relative to this project unless made absolute.
BOOKSEARCH_ARTIFACTS_DIR=artifacts
BOOKSEARCH_EMBEDDING_BACKEND=huggingface
BOOKSEARCH_EMBEDDING_MODEL=microsoft/harrier-oss-v1-270m
# Pin a model tag or commit before the accepted demo build.
BOOKSEARCH_EMBEDDING_MODEL_REVISION=
BOOKSEARCH_EMBEDDING_DEVICE=cuda
BOOKSEARCH_RERANKER_BACKEND=crossencoder
BOOKSEARCH_RERANKER_DEVICE=cuda
BOOKSEARCH_RERANK_TOP_K=48
BOOKSEARCH_FINAL_TOP_K=10
BOOKSEARCH_LLM_QUERY_UNDERSTANDING=never
BOOKSEARCH_RAG_FUSION=false
BOOKSEARCH_TRACE_QUERIES=true

# Reader app defaults: 48 ranked once, 12 displayed per page.
BOOKSEARCH_WEB_RANKED_RESULTS=48
BOOKSEARCH_WEB_PAGE_SIZE=12
BOOKSEARCH_WEB_SEARCH_WAIT_S=2
BOOKSEARCH_WEB_DIAGNOSTICS=false
